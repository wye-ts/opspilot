generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma-client"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

model AgentJob {
  id               String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  ticketContext    Json     @map("ticket_context")
  externalTicketId String   @map("external_ticket_id")
  createdAt        DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  runs AgentRun[]

  @@map("agent_jobs")
}

model AgentRun {
  id              String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  jobId           String    @map("job_id") @db.Uuid
  attemptNumber   Int       @map("attempt_number")
  status          String
  providerMode    String    @map("provider_mode")
  modelIdentifier String?   @map("model_identifier")
  report          Json?
  failureCode     String?   @map("failure_code")
  startedAt       DateTime  @map("started_at") @db.Timestamptz(6)
  finishedAt      DateTime? @map("finished_at") @db.Timestamptz(6)
  createdAt       DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  // Per-run provider usage, all NULLABLE and all left NULL for a FAKE run.
  // "Not measured" and "measured as zero" are different facts, and a FAKE run
  // makes no provider call at all — writing 0 would claim a measurement that
  // never happened, and would make a genuine zero-cost LIVE run
  // indistinguishable from a deterministic one.
  //
  // Cost is BigInt nanoUSD, never a float: see apps/api/src/execution/nano-usd.ts.
  /// The client-generated key that made this run's CREATION idempotent, or NULL
  /// for a run created before the key existed (and for every FAKE run, which is
  /// free to repeat).
  ///
  /// Uniqueness is `(job_id, client_request_id) WHERE client_request_id IS NOT
  /// NULL` — a PARTIAL unique index, hand-authored in the migration because
  /// Prisma's DSL cannot express a WHERE clause on `@@unique`. Declaring a plain
  /// `@@unique` here instead would generate a DIFFERENT (total) index and put
  /// the schema permanently at odds with the migration, so this field is
  /// deliberately declared WITHOUT one. Same reasoning as the CHECK constraints
  /// this schema also leaves to hand-authored SQL.
  clientRequestId String? @map("client_request_id") @db.Uuid

  providerCallsObserved  Int?     @map("provider_calls_observed")
  inputTokens            Int?     @map("input_tokens")
  outputTokens           Int?     @map("output_tokens")
  estimatedCostNanoUsd   BigInt?  @map("estimated_cost_nano_usd")
  pricingStatus          String?  @map("pricing_status")
  possibleUnobservedCost Boolean? @map("possible_unobserved_cost")

  job         AgentJob          @relation(fields: [jobId], references: [id], onDelete: Cascade)
  traceEvents AgentTraceEvent[]
  approval    AgentRunApproval?

  @@unique([jobId, attemptNumber])
  // Supports the in-transaction "count LIVE runs for this job" that enforces
  // the per-job live attempt limit (see startLiveRunWithAttemptLimit).
  @@index([jobId, providerMode])
  @@map("agent_runs")
}

/// One row per UTC day. The durable half of the live-run budget: the daily run
/// count is reserved inside the same transaction that creates the run, so it is
/// a HARD cap, while the cost figure is reconciled after the run finishes and
/// therefore only stops SUBSEQUENT runs.
///
/// `budget_date` is the primary key and the only access path — there is no
/// surrogate id, because "the budget for a given UTC day" is exactly the
/// identity of a row here. A new day gets a new row on first use; no cron job,
/// no reset task, and process restarts are irrelevant.
model LiveRunBudget {
  budgetDate           DateTime @id @map("budget_date") @db.Date
  runsReserved         Int      @default(0) @map("runs_reserved")
  runsCompleted        Int      @default(0) @map("runs_completed")
  estimatedCostNanoUsd BigInt   @default(0) @map("estimated_cost_nano_usd")
  /// Number of runs whose true cost could not be established. Any value above
  /// zero closes the cost gate for the rest of the day — an unknown cost is
  /// never reconciled as a known $0.
  pricingUnknownRuns   Int      @default(0) @map("pricing_unknown_runs")
  /// PUBLIC-scoped subset of `runsReserved` (issue #39). No completed
  /// counterpart: the shared `runsCompleted = runsReserved` latch above is
  /// the sole staleness guard for both the private and public paths.
  publicRunsReserved         Int    @default(0) @map("public_runs_reserved")
  /// PUBLIC-scoped subset of `estimatedCostNanoUsd` (issue #39).
  publicEstimatedCostNanoUsd BigInt @default(0) @map("public_estimated_cost_nano_usd")
  updatedAt            DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@map("live_run_budget")
}

/// One row per `(visitorId, usageDate)` — the durable per-visitor half of the
/// PUBLIC LIVE trial's daily gate (issue #39). Insert-only: written once via
/// `ON CONFLICT DO NOTHING` at reservation time
/// (`startLiveRunWithAttemptLimit`) and never updated afterward — the row's
/// mere presence for today is the entire fact this table records, so there is
/// no counter column and no reconciliation step.
model LiveRunVisitorUsage {
  visitorId String   @map("visitor_id") @db.Uuid
  usageDate DateTime @map("usage_date") @db.Date
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@id([visitorId, usageDate])
  @@map("live_run_visitor_usage")
}

model AgentRunApproval {
  id           String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  runId        String   @unique @map("run_id") @db.Uuid
  decision     String
  reviewerName String   @map("reviewer_name")
  note         String?
  decidedAt    DateTime @default(now()) @map("decided_at") @db.Timestamptz(6)

  run AgentRun @relation(fields: [runId], references: [id], onDelete: Cascade)

  @@map("agent_run_approvals")
}

model AgentTraceEvent {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  runId          String   @map("run_id") @db.Uuid
  sequenceNumber Int      @map("sequence_number")
  eventType      String   @map("event_type")
  payload        Json
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  run AgentRun @relation(fields: [runId], references: [id], onDelete: Cascade)

  @@unique([runId, sequenceNumber])
  @@map("agent_trace_events")
}
