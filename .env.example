# Local PostgreSQL (see docker-compose.yml). Copy this file to .env at the
# repo root — .env is gitignored — and adjust only if you changed
# docker-compose.yml's credentials or port mapping.
#
# Host port 55432 (not the default 5432) — this avoids conflicting with a
# pre-existing local Postgres instance some developer machines already run
# on 5432. The container's internal port is still the standard 5432.
DATABASE_URL=postgres://opspilot:opspilot_local_dev_only@localhost:55432/opspilot
TEST_DATABASE_URL=postgres://opspilot:opspilot_local_dev_only@localhost:55432/opspilot_test

# Used only by `pnpm db:migrate:drift` (prisma migrate diff), which needs a
# throwaway database to replay the committed migrations into for comparison.
# `pnpm db:test:ensure` creates this database itself (it does NOT get
# created automatically by Prisma) — Prisma only uses/resets its contents
# as the migration-diff comparison target once it already exists.
SHADOW_DATABASE_URL=postgres://opspilot:opspilot_local_dev_only@localhost:55432/opspilot_shadow

# apps/api (see docs/12-agent-run-api.md §7.1) — local-only, both optional.
# PORT: HTTP port for `pnpm --filter @opspilot/api run start` (default 3000).
#
# AGENT_RUN_PROVIDER_MODE is the DEFAULT REQUEST MODE: what a run request that
# omits `providerMode` gets. Since PR 6B1 a request may ask for LIVE explicitly,
# so this is no longer the only mode the API supports. Exactly FAKE or LIVE;
# anything else fails startup. Setting it to LIVE without live capability
# configured also fails startup, since every defaulted request would then error.
PORT=3000
AGENT_RUN_PROVIDER_MODE=FAKE

# Live Claude capability for apps/api — entirely OPTIONAL. With neither set,
# the API starts normally, serves FAKE, and refuses a requested LIVE run with
# 503. That is the normal local and CI configuration.
#
# Set BOTH or NEITHER. A key without a model, or a model without a key, fails
# startup rather than being treated as "no capability" — a half-configured
# deployment meant to be live must not quietly become a deterministic one.
#
# Never put a real value here: this file is committed. Export the key in your
# shell instead.
# ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-sonnet-5
# ANTHROPIC_TIMEOUT_MS=45000      # PER-ATTEMPT SDK timeout, not a total budget
# ANTHROPIC_MAX_RETRIES=1         # the SDK is the sole retry owner

# The live kill switch. Defaults to FALSE, so a fully configured process still
# refuses live runs until this is deliberately set — adding a credential is not
# by itself enough to start spending money. Only the exact lowercase strings
# 'true' and 'false' are accepted; anything else fails startup rather than being
# guessed at, because a typo that silently means `false` is indistinguishable
# from a deliberate `false`.
# LIVE_AGENT_RUNS_ENABLED=false

# A caller-owned deadline covering Anthropic provider calls across a run. A
# product-level execution budget, not a worst-case formula: the SDK's
# per-attempt timeout and retry ceiling are separate, and retry backoff plus any
# retry-after delay add time on top of both.
#
# Scope: provider calls only. Tool execution, retrieval, and persistence are NOT
# cancelled by it, so this is not whole-run cancellation.
# AGENT_RUN_PROVIDER_DEADLINE_MS=120000

# Production/container-only (see docs/08-cicd-deployment.md) — all optional,
# none needed for ordinary local development.
# HOST: bind address. Defaults to 127.0.0.1 locally; the container sets
#   this to 0.0.0.0 itself (Dockerfile ENV / render.yaml).
# WEB_DIST_DIR: overrides where the built React app is served from. Defaults
#   to apps/web/dist, resolved relative to apps/api/dist/main.js — leave
#   unset unless the monorepo layout changes.
# RUN_MIGRATIONS_ON_START: set to "false" to skip docker/entrypoint.sh's
#   `prisma migrate deploy` on container start (defaults to migrations on).
#   Only the exact lowercase strings "true" and "false" are accepted — any
#   other value (including "True", "1", or a typo) fails startup with a
#   clear error rather than silently skipping migrations.
# MIGRATION_RETRY_ATTEMPTS: bounded retry count around `prisma migrate
#   deploy` in the entrypoint, absorbing a Neon free-tier cold start
#   (default 5).
# MIGRATION_RETRY_DELAY_SECONDS: fixed delay between retry attempts
#   (default 3).
# MIGRATION_DATABASE_URL: overrides DATABASE_URL for the migration step
#   only — the escape hatch for a future pooled (PgBouncer) runtime
#   connection, since `migrate deploy`'s advisory locks do not survive
#   transaction pooling.
# HOST=0.0.0.0
# WEB_DIST_DIR=
# RUN_MIGRATIONS_ON_START=true
# MIGRATION_RETRY_ATTEMPTS=5
# MIGRATION_RETRY_DELAY_SECONDS=3
# MIGRATION_DATABASE_URL=
