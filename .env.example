# Local PostgreSQL (see docker-compose.yml). Copy this file to .env at the
# repo root — .env is gitignored — and adjust only if you changed
# docker-compose.yml's credentials or port mapping.
#
# Host port 55432 (not the default 5432) — this avoids conflicting with a
# pre-existing local Postgres instance some developer machines already run
# on 5432. The container's internal port is still the standard 5432.
DATABASE_URL=postgres://opspilot:opspilot_local_dev_only@localhost:55432/opspilot
TEST_DATABASE_URL=postgres://opspilot:opspilot_local_dev_only@localhost:55432/opspilot_test

# Used only by `pnpm db:migrate:drift` (prisma migrate diff), which needs a
# throwaway database to replay the committed migrations into for comparison.
# `pnpm db:test:ensure` creates this database itself (it does NOT get
# created automatically by Prisma) — Prisma only uses/resets its contents
# as the migration-diff comparison target once it already exists.
SHADOW_DATABASE_URL=postgres://opspilot:opspilot_local_dev_only@localhost:55432/opspilot_shadow

# apps/api (see docs/12-agent-run-api.md §7.1) — local-only, both optional.
# PORT: HTTP port for `pnpm --filter @opspilot/api run start` (default 3000).
#
# AGENT_RUN_PROVIDER_MODE is the DEFAULT REQUEST MODE: what a run request that
# omits `providerMode` gets. Since PR 6B1 a request may ask for LIVE explicitly,
# so this is no longer the only mode the API supports. Exactly FAKE or LIVE;
# anything else fails startup. Setting it to LIVE without live capability
# configured also fails startup, since every defaulted request would then error.
PORT=3000
AGENT_RUN_PROVIDER_MODE=FAKE

# Live Claude capability for apps/api — entirely OPTIONAL. With neither set,
# the API starts normally, serves FAKE, and refuses a requested LIVE run with
# 503. That is the normal local and CI configuration.
#
# Set BOTH or NEITHER. A key without a model, or a model without a key, fails
# startup rather than being treated as "no capability" — a half-configured
# deployment meant to be live must not quietly become a deterministic one.
#
# Never put a real value here: this file is committed. Export the key in your
# shell instead.
# ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-sonnet-5
# ANTHROPIC_TIMEOUT_MS=45000      # PER-ATTEMPT SDK timeout, not a total budget
#
# ANTHROPIC_MAX_RETRIES: the SDK is the sole retry owner. MUST BE 0 once live
# capability is present AND LIVE_AGENT_RUNS_ENABLED=true — the API refuses to
# start otherwise. A retried request reports only the last attempt: an earlier
# attempt may have reached the provider and may have been billed, and nothing in
# the response says whether it did, so a run's cost could not be reported
# honestly. The per-job live attempt limit is the explicit, durable retry
# boundary instead. A worker or other non-public flow (kill switch off) may still
# set 1..5.
# ANTHROPIC_MAX_RETRIES=0

# The live kill switch. Defaults to FALSE, so a fully configured process still
# refuses live runs until this is deliberately set — adding a credential is not
# by itself enough to start spending money. Only the exact lowercase strings
# 'true' and 'false' are accepted; anything else fails startup rather than being
# guessed at, because a typo that silently means `false` is indistinguishable
# from a deliberate `false`.
# LIVE_AGENT_RUNS_ENABLED=false

# A caller-owned deadline covering Anthropic provider calls across a run. A
# product-level execution budget, not a worst-case formula: the SDK's
# per-attempt timeout and retry ceiling are separate, and retry backoff plus any
# retry-after delay add time on top of both.
#
# Scope: provider calls only. Tool execution, retrieval, and persistence are NOT
# cancelled by it, so this is not whole-run cancellation.
# AGENT_RUN_PROVIDER_DEADLINE_MS=120000

# Production/container-only (see docs/08-cicd-deployment.md) — all optional,
# none needed for ordinary local development.
# HOST: bind address. Defaults to 127.0.0.1 locally; the container sets
#   this to 0.0.0.0 itself (Dockerfile ENV / render.yaml).
# WEB_DIST_DIR: overrides where the built React app is served from. Defaults
#   to apps/web/dist, resolved relative to apps/api/dist/main.js — leave
#   unset unless the monorepo layout changes.
# RUN_MIGRATIONS_ON_START: set to "false" to skip docker/entrypoint.sh's
#   `prisma migrate deploy` on container start (defaults to migrations on).
#   Only the exact lowercase strings "true" and "false" are accepted — any
#   other value (including "True", "1", or a typo) fails startup with a
#   clear error rather than silently skipping migrations.
# MIGRATION_RETRY_ATTEMPTS: bounded retry count around `prisma migrate
#   deploy` in the entrypoint, absorbing a Neon free-tier cold start
#   (default 5).
# MIGRATION_RETRY_DELAY_SECONDS: fixed delay between retry attempts
#   (default 3).
# MIGRATION_DATABASE_URL: overrides DATABASE_URL for the migration step
#   only — the escape hatch for a future pooled (PgBouncer) runtime
#   connection, since `migrate deploy`'s advisory locks do not survive
#   transaction pooling.
# HOST=0.0.0.0
# WEB_DIST_DIR=
# RUN_MIGRATIONS_ON_START=true
# MIGRATION_RETRY_ATTEMPTS=5
# MIGRATION_RETRY_DELAY_SECONDS=3
# MIGRATION_DATABASE_URL=

# ── PR 6B2: protected live-run safeguards ──────────────────────────────────
# Every value below is optional and ships with the default shown. All of them
# are INERT while LIVE_AGENT_RUNS_ENABLED is false, which is the default and the
# posture the deployment ships in.
#
# Three separate things must all be true before a single paid request is
# possible, and none of them implies the others:
#   1. ANTHROPIC_API_KEY + ANTHROPIC_MODEL are set  (live capability exists)
#   2. LIVE_AGENT_RUNS_ENABLED=true                  (the kill switch is off)
#   3. LIVE_RUN_ACCESS_TOKEN is set                  (callers can authenticate)
# Adding a key alone does NOT enable paid execution. Turning the switch on alone
# is equally insufficient — with a credential present and the switch on but no
# token, startup FAILS rather than exposing a tokenless public LIVE path. There
# is no public tokenless mode in this release.

# The shared demo token a LIVE request must present as X-OpsPilot-Demo-Token.
# Never logged, never persisted, never placed in a URL. Required for the first
# public LIVE release.
# LIVE_RUN_ACCESS_TOKEN=

# Per-turn output ceiling for an API live run. Hard PER PROVIDER ATTEMPT.
#
# The daily output envelope is:
#   maxOutputTokens x maxAgentTurns x (maxRetries + 1) x dailyRunLimit
#
# The protected public LIVE path requires ANTHROPIC_MAX_RETRIES=0 (see below), so
# at shipped defaults that is 1024 x 2 x 1 x 10 = 20,480 output tokens/day. With
# retries enabled the envelope grows by the (maxRetries + 1) factor, which is one
# of the reasons the public path forbids them.
# Integer 256–4096.
# LIVE_RUN_MAX_OUTPUT_TOKENS=1024

# Live attempts per agent job. HARD: enforced inside the same transaction that
# creates the run, so two concurrent requests for the final attempt cannot both
# win. Integer 1–10.
# LIVE_RUN_MAX_ATTEMPTS_PER_JOB=2

# Concurrent live runs, PER PROCESS. Rejects rather than queues — a live run
# carries its own deadline, so queuing would turn a fast 429 into a slow
# timeout. On a single-instance plan this is also the global limit; on any
# multi-instance plan it is not.
#
# MUST BE EXACTLY 1 in this release; any other value fails startup. The cost
# ceiling below is post-run accounting on an ESTIMATE, and the documented bound
# -- that the OBSERVED RECONCILED ESTIMATE can cross the ceiling by at most one
# IN-FLIGHT LOGICAL RUN -- holds only at a concurrency of 1: with N concurrent
# runs, all N can see an accumulated cost under the ceiling, reserve, and spend
# before any of them reconciles. The bound is on the estimate; actual provider
# billing is not bounded by it.
# LIVE_RUN_MAX_CONCURRENCY=1

# Live requests per client per window, and the window length. In-process and
# reset on restart. Raises the cost of casual abuse; it is NOT identity and NOT
# a spend guarantee. Integers 1–60 and 1000–3600000.
# LIVE_RUN_RATE_LIMIT_MAX=2
# LIVE_RUN_RATE_LIMIT_WINDOW_MS=60000

# Live runs per UTC day. HARD: reserved inside the run-creation transaction,
# before any Anthropic call. Integer 1–1000.
# LIVE_RUN_DAILY_LIMIT=10

# Daily cost ceiling, as a decimal USD string parsed to exact integer nanoUSD.
#
# NOT a hard dollar cap, and not a bound on actual billing. It is post-run
# accounting on an ESTIMATE: crossing it refuses SUBSEQUENT runs for the rest of
# the UTC day, so the observed reconciled estimate can cross the ceiling by at
# most one in-flight logical run.
#
# ACTUAL PROVIDER BILLING MAY BE HIGHER than any estimate recorded here, after an
# ambiguous network outcome or a process termination. The daily run count above
# is the hard control.
#
# Cost figures are also a LOWER BOUND: with ANTHROPIC_MAX_RETRIES > 0, a turn that
# fails and succeeds on retry reports only the final attempt's usage, so an
# abandoned-but-billed attempt is not observable. A run whose cost cannot be
# established closes the cost gate for the remainder of that day rather than
# being counted as free.
# LIVE_RUN_DAILY_COST_CEILING_USD=1.00

# How many reverse-proxy hops may be trusted to have set X-Forwarded-For, which
# is what the per-client rate limit derives its identity from. A NUMBER, never
# `true`: `true` makes Express take the leftmost (client-supplied) entry, which
# would make every rate-limit bucket client-selectable.
#
# REQUIRES EMPIRICAL VERIFICATION behind a real proxy before this value is
# trusted — see docs/08-cicd-deployment.md. Integer 0–5.
# TRUST_PROXY_HOPS=1
